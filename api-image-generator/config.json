{
  "provider": "速创API",
  "platform": "https://api.wuyinkeji.com",
  "docs": {
    "generate": "https://api.wuyinkeji.com/doc/53",
    "detail": "https://api.wuyinkeji.com/doc/47"
  },
  "api_key": "ToamgJxkycib1LO7YoyZ5yusAQ",
  "env_key_override": "WUYIN_API_KEY",
  "endpoints": {
    "generate": "https://api.wuyinkeji.com/api/async/image_gpt",
    "detail": "https://api.wuyinkeji.com/api/async/detail"
  },
  "pricing": "0.1 元/张（10 点/张）",
  "auth": {
    "header": "Authorization",
    "query_param": "key"
  },
  "prompt": {
    "base": "A photorealistic editorial photograph of {subject}, {style}, {lighting}, {composition}, high detail, 8k, {negative}",
    "style": "vibrant natural colors, travel editorial photography",
    "lighting": "soft natural light, golden hour ambiance",
    "composition": "centered composition",
    "negative": "no text, no watermark, no logo, no extra objects"
  },
  "size": {
    "default": "1:1",
    "by_use": {
      "hero": "16:9",
      "article": "3:2",
      "card": "1:1",
      "portrait": "9:16",
      "poster": "2:3",
      "og": "16:9"
    }
  },
  "poll": {
    "interval_seconds": 5,
    "max_attempts": 120,
    "max_wait_minutes": 10
  },
  "batch": {
    "submit_threads": 5,
    "poll_threads": 5,
    "default_output_dir": "generated"
  },
  "sizes": [
    "auto", "1:1", "3:2", "2:3", "16:9", "9:16", "4:3", "3:4",
    "21:9", "9:21", "1:3", "3:1", "2:1", "1:2"
  ],
  "image_processing": {
    "format": "webp",
    "quality": 80,
    "filename_style": "kebab-case"
  },
  "status_codes": {
    "0": "初始化",
    "1": "进行中",
    "2": "成功",
    "3": "失败"
  }
}
