/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' https:; script-src 'self' 'sha256-...'; style-src 'unsafe-inline' 'self'; connect-src 'self'; frame-ancestors 'none'
